# Copy to .env.local and fill in. Never commit .env.local.
# Only the realtime vendor-order-notification settings are listed here.
# NEXT_PUBLIC_* values are inlined into the browser bundle at BUILD time: changing one
# needs a rebuild and redeploy, and none of them may ever hold a secret. The Pusher app
# SECRET lives only in the API's environment (PUSHER_APP_SECRET).

# REST API base URL. MUST include the scheme (https://...). Channel auth is called at
# <this>/broadcasting/auth; without a scheme the browser treats it as a relative path.
NEXT_PUBLIC_REST_API_ENDPOINT=

# Master switches. Realtime order alerts run only when BOTH are set:
#   NEXT_PUBLIC_API_BROADCAST_DRIVER=pusher   (anything else, or empty, disables realtime)
#   NEXT_PUBLIC_PUSHER_ENABLED=true           (anything else, or empty, disables realtime)
NEXT_PUBLIC_API_BROADCAST_DRIVER=
NEXT_PUBLIC_PUSHER_ENABLED=

# Public key and cluster of the SAME Pusher app the API publishes to
# (the API's PUSHER_APP_KEY and PUSHER_APP_CLUSTER, e.g. ap2).
NEXT_PUBLIC_PUSHER_APP_KEY=
NEXT_PUBLIC_PUSHER_APP_CLUSTER=

# Optional. Full URL for channel auth when it is not <REST endpoint>/broadcasting/auth.
NEXT_PUBLIC_BROADCAST_AUTH_URL=

# Channel prefix and event for new paid orders. Must match the API's
# VENDOR_ORDER_PUSHER_CHANNEL_PREFIX and VENDOR_ORDER_PUSHER_EVENT.
# Defaults when empty: private-order.created and order.create.event.
NEXT_PUBLIC_ORDER_CREATED_CHANNEL_PRIVATE=
NEXT_PUBLIC_ORDER_CREATED_EVENT=

# Other realtime channels that share the same Pusher connection.
NEXT_PUBLIC_MESSAGE_CHANNEL_PRIVATE=
NEXT_PUBLIC_MESSAGE_EVENT=
NEXT_PUBLIC_STORE_NOTICE_CREATED_CHANNEL_PRIVATE=
NEXT_PUBLIC_STORE_NOTICE_CREATED_EVENT=

# "true" logs Pusher connection details to the browser console. Leave empty in production.
NEXT_PUBLIC_PUSHER_DEV_MOOD=
