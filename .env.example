# Copy to .env.local and fill in. Never commit .env.local.
# Only the realtime vendor-order-notification settings are listed here.
# EVERYTHING prefixed NEXT_PUBLIC_ is shipped to the browser: never put a secret in it.
# The Pusher app SECRET lives only in the API's environment (PUSHER_APP_SECRET).

# Master switches. Realtime order alerts run only when BOTH are set as below.
NEXT_PUBLIC_API_BROADCAST_DRIVER=log     # "pusher" to turn realtime on
NEXT_PUBLIC_PUSHER_ENABLED=false         # "true" to connect to Pusher

# Public Pusher app key and cluster: same key as the API's PUSHER_APP_KEY, and
# the same cluster (PUSHER_APP_CLUSTER).
NEXT_PUBLIC_PUSHER_APP_KEY=
NEXT_PUBLIC_PUSHER_APP_CLUSTER=ap2

# Private-channel authorisation. Defaults to <NEXT_PUBLIC_REST_API_ENDPOINT>/broadcasting/auth;
# only set this if the API is served from somewhere else.
NEXT_PUBLIC_BROADCAST_AUTH_URL=

# Channel prefix and event for new paid orders. Must match the API's
# VENDOR_ORDER_PUSHER_CHANNEL_PREFIX and VENDOR_ORDER_PUSHER_EVENT.
NEXT_PUBLIC_ORDER_CREATED_CHANNEL_PRIVATE=private-order.created
NEXT_PUBLIC_ORDER_CREATED_EVENT=order.create.event

# Other realtime channels that share the same Pusher connection.
NEXT_PUBLIC_MESSAGE_CHANNEL_PRIVATE=
NEXT_PUBLIC_MESSAGE_EVENT=
NEXT_PUBLIC_STORE_NOTICE_CREATED_CHANNEL_PRIVATE=
NEXT_PUBLIC_STORE_NOTICE_CREATED_EVENT=

# Set "true" to log Pusher connection details to the browser console.
NEXT_PUBLIC_PUSHER_DEV_MOOD=false
